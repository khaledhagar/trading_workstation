# Required for AI chat: OpenRouter API key
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data. Empty = built-in simulator
MASSIVE_API_KEY=

# Optional (Massive only): "snapshot" (paid plans) or "eod" (free plan). Empty = auto-detect
MASSIVE_MODE=

# Optional (snapshot mode only): seconds between polls. Default 15, minimum 2
MASSIVE_POLL_INTERVAL=

# Optional: "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false

# Optional: SQLite file. Default <project root>/db/trading_workstation.db (Docker sets /app/db/...)
DB_PATH=
